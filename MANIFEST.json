{
  "name": "multi-repo-impact-review",
  "version": "2.0.0",
  "distribution": "source-repository; runnable platform packages are published as GitHub Release assets",
  "platforms": ["darwin-arm64", "darwin-amd64", "linux-amd64", "linux-arm64", "windows-amd64", "windows-arm64"],
  "agentHosts": ["Codex", "Claude Code"],
  "networkRequired": false,
  "graphEngine": {
    "name": "codebase-memory-mcp",
    "version": "0.10.2",
    "license": "MIT",
    "repository": "https://github.com/DeusData/codebase-memory-mcp",
    "runtimePathTemplate": "runtime/<platform>/codebase-memory-mcp[.exe]"
  },
  "graphFormat": "codebase-memory-graph.db.zst",
  "knowledgePacks": ["common", "embedded-lua-services", "scriptswtlua", "mobiwtlua"],
  "callChainPolicy": {
    "defaultDepth": 2,
    "hardMaxDepth": 4,
    "defaultPerTraceRows": 30,
    "hardMaxPerTraceRows": 100,
    "defaultGlobalUniqueNodes": 120,
    "hardMaxGlobalUniqueNodes": 400
  }
}
